# ==========================================
# سync (Sync) Platform Environment Variables
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="سync Dropshipping Platform"
API_V1_STR="/api/v1"
SECRET_KEY=dev_secret_key_change_in_production_9f834a81b2c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sync_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sync_db

# Redis (Caching & Distributed Locks)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# RabbitMQ (Task Message Broker)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security & Encryption (Fernet Key for sensitive supplier/marketplace credentials at rest)
CREDENTIAL_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS1mb3ItZGV2IQ==

# Initial Superuser Seed
FIRST_SUPERUSER_EMAIL=admin@syncplatform.io
FIRST_SUPERUSER_PASSWORD=adminpassword123

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Storage (AWS S3 or Cloudinary - optional in V1 / mock)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability & Alerts (Optional)
SENTRY_DSN=
SLACK_WEBHOOK_URL=

# Suppliers (Credentials are encrypted in DB; placeholders for direct override if needed)
DNH_ACCOUNT_NUMBER=
DNH_LOGIN=
DNH_PASSWORD=
INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=
TD_SYNNEX_USERNAME=
TD_SYNNEX_PASSWORD=
MALABS_API_KEY=
VOICECOMM_API_KEY=

# Marketplaces (Credentials are encrypted in DB; placeholders for direct override if needed)
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_USER_TOKEN=
AMAZON_SELLER_ID=
AMAZON_REFRESH_TOKEN=
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
SHOPIFY_STORE_DOMAIN=
